import { Button, LineEdit, Palette, ScrollView } from "std-widgets.slint";

component Heading inherits Text {
    font-size: 18px;
    font-weight: 700;
    color: #182c3b;
}
component BodyText inherits Text {
    color: #44596a;
    wrap: word-wrap;
}
component Card inherits Rectangle {
    background: #ffffff;
    border-width: 1px;
    border-color: #d8e1e5;
    border-radius: 10px;
}
export component MainWindow inherits Window {
    title: "GPTGuard";
    preferred-width: 840px;
    preferred-height: 610px;
    min-width: 490px;
    min-height: 340px;
    background: #f4f7f8;

    in property <string> status_text: "正在连接后台";
    in property <string> detail_text;
    in property <string> action_text;
    in property <bool> action_failed;
    in property <bool> state_known;
    in property <bool> protection_enabled;
    in property <bool> protection_healthy;
    in property <bool> protection_problem;
    in property <bool> operation_busy;
    in property <string> route_text: "正在读取出口配置";
    in property <string> codex_text: "正在读取 Codex 配置";
    in property <bool> setup_needed;
    in property <string> takeover_label: "确认接管配置";
    in property <string> doctor_text;
    in property <string> about_text;
    in property <string> trust_candidate_ip;
    in property <string> trust_candidate_proxy;
    in property <bool> activate_after_trust;
    private property <bool> show_more: false;
    private property <bool> show_doctor: false;
    private property <bool> show_about: false;
    private property <bool> ready: root.state_known && !root.operation_busy;

    init => { Palette.color-scheme = ColorScheme.light; }
    callback refresh_clicked();
    callback connect_local_clicked();
    callback trust_local_exit_clicked(string, string, bool);
    callback import_clicked(string);
    callback file_clicked();
    callback add_exit_clicked(string);
    callback takeover_clicked();
    callback restore_clicked();
    callback protection_clicked(bool);

    ScrollView {
        horizontal-scrollbar-policy: always-off;
        content-width: self.visible-width;
        VerticalLayout {
            padding: 22px;
            spacing: 12px;
            alignment: start;
            HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    Text { text: "GPTGuard"; font-size: 26px; font-weight: 750; color: #182c3b; }
                    BodyText { text: "出口保护与 Codex 网关"; }
                }
                Rectangle { horizontal-stretch: 1; }
                Button { text: "检测出口"; height: 34px; enabled: root.ready; clicked => { root.refresh_clicked(); } }
                Button { text: root.show_doctor ? "收起诊断" : "查看诊断"; height: 34px; clicked => { root.show_doctor = !root.show_doctor; } }
                Button { text: "关于"; height: 34px; clicked => { root.show_about = !root.show_about; } }
            }
            if root.show_about: BodyText { text: root.about_text; }
            Card {
                background: root.protection_problem ? #fff3ef : root.protection_healthy ? #e9f6ee : #eef4f6;
                border-color: root.protection_problem ? #dfa899 : root.protection_healthy ? #a0ccae : #c4d5db;
                VerticalLayout {
                    padding: 16px;
                    spacing: 7px;
                    HorizontalLayout {
                        spacing: 12px;
                        Heading { text: root.status_text; vertical-alignment: center; horizontal-stretch: 1; font-size: 22px; }
                        protection := Button {
                            text: root.protection_enabled ? "关闭严格保护" : "开启严格保护";
                            primary: !root.protection_enabled;
                            height: 36px;
                            enabled: root.ready;
                            clicked => { root.protection_clicked(!root.protection_enabled); }
                        }
                    }
                    BodyText { text: root.detail_text; }
                    if root.action_text != "": BodyText {
                        text: root.action_text;
                        font-weight: 600;
                        color: root.action_failed ? #983522 : #155865;
                    }
                    if root.trust_candidate_ip != "": HorizontalLayout {
                        alignment: start;
                        Button {
                            text: (root.activate_after_trust ? "信任并开启保护 · " : "信任出口 · ") + root.trust_candidate_ip;
                            enabled: root.ready;
                            primary: true;
                            clicked => { root.trust_local_exit_clicked(root.trust_candidate_ip, root.trust_candidate_proxy, root.activate_after_trust); }
                        }
                    }
                }
            }
            if root.show_doctor: Card {
                VerticalLayout {
                    padding: 16px;
                    spacing: 6px;
                    Heading { text: "后台诊断"; }
                    BodyText { text: root.doctor_text == "" ? "等候后台返回诊断结果" : root.doctor_text; }
                }
            }
            Card {
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    Heading { text: "代理出口"; }
                    BodyText { text: root.route_text; }
                    HorizontalLayout {
                        alignment: start;
                        spacing: 8px;
                        Button { text: "连接 Clash Verge"; enabled: root.ready; clicked => { root.connect_local_clicked(); } }
                        Button { text: root.show_more ? "收起其他方式" : "其他连接方式"; clicked => { root.show_more = !root.show_more; } }
                    }
                    if root.show_more: VerticalLayout {
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 6px;
                            subscription := LineEdit { placeholder-text: "订阅地址"; enabled: root.ready; }
                            Button { text: "导入订阅"; enabled: root.ready && subscription.text != ""; clicked => { root.import_clicked(subscription.text); } }
                            Button { text: "选择文件"; enabled: root.ready; clicked => { root.file_clicked(); } }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            entry := LineEdit { placeholder-text: "已知的出口 IP 或 CIDR 网段"; enabled: root.ready; }
                            Button { text: "加入白名单"; enabled: root.ready && entry.text != ""; clicked => { root.add_exit_clicked(entry.text); } }
                        }
                    }
                }
            }
            Card {
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    Heading { text: "Codex 网关"; }
                    BodyText { text: root.codex_text; }
                    HorizontalLayout {
                        alignment: start;
                        spacing: 8px;
                        Button { text: root.takeover_label; enabled: root.ready && root.setup_needed; clicked => { root.takeover_clicked(); } }
                        Button { text: "恢复原配置"; enabled: root.ready; clicked => { root.restore_clicked(); } }
                    }
                }
            }
        }
    }
}
