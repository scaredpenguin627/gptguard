import { Button, CheckBox, HorizontalBox, LineEdit, Palette, ScrollView, VerticalBox } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "GPTGuard";
    // Give the guidance card enough room to stay readable on the first run.
    // The previous 620px window left only a narrow strip visible after the
    // status and action cards grew to accommodate diagnostics.
    width: 920px;
    height: 720px;
    background: #f6f7fb;

    in property <string> status_text: "正在启动";
    in property <string> detail_text: "正在连接 GPTGuard 后台";
    in property <string> route_text: "自动检测本机代理，或导入订阅";
    in property <string> codex_text: "正在检测 Codex 配置";
    in property <bool> protection_enabled: false;
    in property <bool> setup_needed: true;
    in property <bool> operation_busy: false;
    in property <bool> trust_candidate_visible: false;
    in property <string> trust_candidate_ip: "";
    in property <string> takeover_label: "确认接管配置";
    in-out property <string> subscription_text: "";

    // The window surface is deliberately light. Keep standard widgets on the
    // same palette when Windows itself is using dark mode.
    init => {
        Palette.color-scheme = ColorScheme.light;
    }

    callback refresh_clicked();
    callback diagnostics_clicked();
    callback about_clicked();
    callback connect_local_clicked();
    callback trust_local_exit_clicked(string);
    callback import_clicked(string);
    callback file_clicked();
    callback takeover_clicked();
    callback restore_clicked();
    callback protection_clicked(bool);

    VerticalBox {
        padding: 28px;
        spacing: 18px;

        HorizontalBox {
            spacing: 12px;
            Text {
                text: "GPTGuard";
                font-size: 28px;
                font-weight: 700;
                color: #182033;
            }
            Text {
                text: "出口保护与 Codex 网关";
                vertical-alignment: center;
                color: #687089;
                font-size: 14px;
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: "立即检测";
                clicked => { root.refresh_clicked(); }
            }
            Button {
                text: "查看诊断";
                clicked => { root.diagnostics_clicked(); }
            }

            Button {
                text: "关于";
                clicked => { root.about_clicked(); }
            }
        }

        Rectangle {
            // Runtime diagnostics can contain several lines. Reserve enough
            // room for them and scroll inside the card instead of letting the
            // text paint over the cards below.
            height: 180px;
            // A failed check must be visually distinct from a healthy
            // protected state. The old card stayed green whenever the
            // checkbox was on, even while the status said "已阻断".
            background: root.status_text == "已阻断" ? #fff0f0 : root.protection_enabled ? #e8f7ee : #fff4dc;
            border-radius: 14px;
            border-width: 1px;
            border-color: root.status_text == "已阻断" ? #efb4b4 : root.protection_enabled ? #b6e3c7 : #f0d18a;

            HorizontalBox {
                padding: 20px;
                spacing: 16px;
                VerticalBox {
                    horizontal-stretch: 1;
                    spacing: 5px;
                    Text {
                        text: root.status_text;
                        font-size: 24px;
                        font-weight: 700;
                        color: #182033;
                    }
                    ScrollView {
                        content-width: self.width;
                        vertical-scrollbar-policy: as-needed;
                        horizontal-scrollbar-policy: always-off;
                        Text {
                            width: parent.width;
                            text: root.detail_text;
                            color: #536078;
                            wrap: word-wrap;
                        }
                    }
                }
                CheckBox {
                    text: root.protection_enabled ? (root.status_text == "已阻断" ? "保护已开启 · 出口已阻断" : "保护已开启") : "开启严格保护";
                    checked: root.protection_enabled;
                    toggled => { root.protection_clicked(self.checked); }
                }
            }
        }

        HorizontalBox {
            spacing: 16px;
            Rectangle {
                horizontal-stretch: 1;
                background: white;
                border-radius: 12px;
                border-width: 1px;
                border-color: #e1e5ee;
                VerticalBox {
                    padding: 18px;
                    spacing: 10px;
                    Text { text: "出口"; font-size: 18px; font-weight: 700; color: #182033; }
                    Text { text: root.route_text; color: #536078; wrap: word-wrap; }
                    Button {
                        text: root.operation_busy ? "正在连接…" : "一键连接 Clash Verge";
                        primary: true;
                        enabled: !root.operation_busy;
                        clicked => { root.connect_local_clicked(); }
                    }
                    LineEdit {
                        placeholder-text: "粘贴订阅地址（可选）";
                        text <=> root.subscription_text;
                        enabled: !root.operation_busy;
                    }
                    // Keep the trust action on its own row. Four buttons in a
                    // single row overflow the export card on a narrow window.
                    Button {
                        visible: root.trust_candidate_visible;
                        text: "信任出口 " + root.trust_candidate_ip;
                        primary: true;
                        enabled: !root.operation_busy;
                        clicked => { root.trust_local_exit_clicked(root.trust_candidate_ip); }
                    }
                    HorizontalBox {
                        spacing: 8px;
                        Button { text: "导入并检测"; enabled: !root.operation_busy; clicked => { root.import_clicked(root.subscription_text); } }
                        Button { text: "选择文件"; enabled: !root.operation_busy; clicked => { root.file_clicked(); } }
                        Button { text: "刷新状态"; enabled: !root.operation_busy; clicked => { root.refresh_clicked(); } }
                    }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                background: white;
                border-radius: 12px;
                border-width: 1px;
                border-color: #e1e5ee;
                VerticalBox {
                    padding: 18px;
                    spacing: 10px;
                    Text { text: "Codex"; font-size: 18px; font-weight: 700; color: #182033; }
                    Text { text: root.codex_text; color: #536078; wrap: word-wrap; }
                    Button { text: root.takeover_label; enabled: root.setup_needed; clicked => { root.takeover_clicked(); } }
                    Button { text: "恢复原配置（保留冲突副本）"; clicked => { root.restore_clicked(); } }
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            background: white;
            border-radius: 12px;
            border-width: 1px;
            border-color: #e1e5ee;
            ScrollView {
                        content-width: self.width;
                VerticalBox {
                    padding: 18px;
                    spacing: 8px;
                    Text { text: "使用说明"; font-size: 18px; font-weight: 700; color: #182033; }
                    Text {
                        text: "首次使用：先点击“一键连接 Clash Verge”；连接不到本机代理时，再粘贴订阅或选择节点文件。连接后会进行真实出口检测，确认 Codex 配置差异后再开启严格保护。节点退出、出口失配或内核损坏时，GPTGuard 会停止转发，不会自动走直连。";
                        color: #536078;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "所有内部端口只监听 127.0.0.1，用户不需要填写端口。管理界面是本地 Rust 桌面窗口，不会打开浏览器。";
                        color: #536078;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
